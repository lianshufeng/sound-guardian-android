<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true" android:background="@color/paper" android:fillViewport="true"><LinearLayout android:padding="20dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="居家声音守护" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="已停止 · 等待开始" android:textColor="@color/muted" android:textSize="16sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/toggle" android:text="开始监听" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="麦克风输入" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ProgressBar android:id="@+id/level" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bg" android:max="100" android:progress="0" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="14dp"/>
<TextView android:id="@+id/inputInfo" android:text="尚未采集 · 电平不是识别置信度" android:textColor="@color/muted" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="当前声音候选" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/candidates" android:text="尚不能确定\n开始监听后显示最近帧的原生候选" android:textColor="@color/ink" android:textSize="16sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="最近事件" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/events" android:text="暂无已确认关注事件" android:textColor="@color/muted" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="诊断" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/diagnostics" android:text="模型：官方 YAMNet classification/tflite/1\n输入：mono float32，16 kHz，15600 samples（约0.975秒）\n步长：约0.48秒；上下文：最近3秒\n事件阈值：Demo 启发式滞回配置，未校准" android:textColor="@color/muted" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
