!core/src/main/assets/model_metadata.json
!models/**/manifest.json
!models/**/metadata.json
!models/**/labels.txt

# Audio and large generated data
/data/raw/*
/data/processed/*
/data/annotations/*
/data/splits/*
*.wav
*.mp3
*.m4a
*.flac
*.pcm
!core/src/androidTest/assets/wakeword-test/*.pcm
