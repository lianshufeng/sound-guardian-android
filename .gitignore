.env.*

# Model weights: retrieve fixed official files with tools/model_tool.py
*.tflite
*.onnx
/libs/*.aar
/libs/*-classes.jar
/evaluation/wakeword-setup/
/evaluation/tts-setup/
/evaluation/understanding-setup/
/core/src/main/assets/tts/model/
